                        "python3 %s note %s 2>/dev/null || echo \"$(date -u +%%FT%%TZ) note: \"%s >> "
                        "~/clash-jobs/state/train_guard.log" % (TW_GUARD, q, q)], capture_output=True, timeout=60)


def cmd_trainwatch(a):
    """One pass (LaunchAgent com.taiwong.trainwatch, every 3 min)."""
    if os.path.exists(TW_DISABLED) and not a.state_file:
        print("trainwatch disabled (%s)" % TW_DISABLED)
        return
    t = now()
    with qlock():
        st = read_json(TW_STATE, {}) or {}
    if a.state_file:
        v, err = tw_view(read_json(a.state_file, {}) or {}, t), None
    else:
        v, err = tw_fetch()
    if err:
        st["fail_streak"] = st.get("fail_streak", 0) + 1
        st["last_error"] = err
        if st["fail_streak"] in (1, 5) or st["fail_streak"] % 20 == 0:
            tw_log("cannot read the guard state (%dx): %s (AS2 asleep or offline: no launch)" % (st["fail_streak"], err))
        with qlock():
            write_json(TW_STATE, st)
        return
    st.update(fail_streak=0, last_ok=t, last_open=[i["id"] for i in v["incidents"]])
    st["stale_streak"] = st.get("stale_streak", 0) + 1 if v["age_s"] > TW_STALE_MIN * 60 else 0
    due = tw_due(v, t, st["stale_streak"])
    launches = {k: [x for x in ts if t - x < 86400] for k, ts in (st.get("launches") or {}).items()}
    launches = {k: ts for k, ts in launches.items() if ts}
    day = [x for x in st.get("day") or [] if t - x < 86400]
    if not due:
        st.update(launches=launches, day=day)
        with qlock():
            write_json(TW_STATE, st)
        if a.verbose:
            print("nothing due (%d open incidents)" % len(v["incidents"]))
        return
    active = [x for x in all_tasks() if x.get("label") == TW_LABEL and x["status"] in ACTIVE]
    fresh = [(i, why) for i, why in due if not launches.get(i["id"]) or
             t - launches[i["id"]][-1] >= TW_COOLDOWN_MIN * 60]
    skip = None
    if active:
        skip = "a fixer is already queued/running (%s)" % active[-1]["id"]
    elif not fresh:
        skip = "cooldown: every due incident had a fixer < %.0f min ago" % TW_COOLDOWN_MIN
    elif len(day) >= TW_MAX_PER_DAY:
        skip = "daily cap: %d fixer launches in 24 h" % len(day)
    ids = ", ".join(i["id"] for i, _ in due)
    if skip:
        key = skip.split(":")[0].split(" (")[0] + "|" + ids
        if st.get("last_skip") != key:   # log each distinct skip once, not every 3 min
            tw_log("due %s: no launch, %s" % (ids, skip))
            st["last_skip"] = key
        st.update(launches=launches, day=day)
        with qlock():
            write_json(TW_STATE, st)
        return
    if not v.get("current_md") and not a.state_file:
        v["current_md"] = tw_current()     # fresh from AS2 at launch time
    prompt = tw_prompt(v, fresh)
    if a.dry_run:
        print("[dry-run] would queue a codex task (label %s, timeout %s) for: %s\n--- prompt\n%s"
              % (TW_LABEL, TW_TIMEOUT, ", ".join(i["id"] for i, _ in fresh), prompt))
        return
    task = make_task(prompt, label=TW_LABEL, runner="codex", priority=8, owner="trainwatch", max_attempts=1,
                     cwd=HOME, timeout_s=parse_duration(TW_TIMEOUT), effort=a.effort,
                     source={"trainwatch": [i["id"] for i, _ in fresh], "kinds": [i["kind"] for i, _ in fresh]})
    for i, _ in fresh:
        launches.setdefault(i["id"], []).append(t)
    day.append(t)
    st.update(launches=launches, day=day, last_skip=None, last_launch={"task": task["id"], "at": t,
                                                                       "incidents": [i["id"] for i, _ in fresh]})
    with qlock():
        write_json(TW_STATE, st)
    msg = "LAUNCH codex fixer %s (%s, %d/%d today) for %s" % (task["id"], CODEX_MODEL, len(day), TW_MAX_PER_DAY,
                                                             "; ".join("%s %s (%s)" % (i["id"], i["kind"], w)
                                                                       for i, w in fresh))
    tw_log(msg)
    if not a.state_file:
        tw_guard_note("trainwatch (Mac): " + msg)


