def notes_for(keys):
    out = []
    for k in keys:
        if not k:
            continue
        p = os.path.join(NOTES, safe(k) + ".md")
        if os.path.exists(p):
            with open(p) as f:
                out.append(f.read()[-6000:])
    return "\n".join(out)


SESSION_MAX_BYTES = int(os.environ.get("AQ_SESSION_MAX_MB", "3")) * 1024 * 1024


def session_too_big(session_id):
    """A transcript this big costs a lot of usage to reload on every resume: hand off to a fresh session instead."""
    tr = find_transcript(session_id)
    try:
        return bool(tr) and os.path.getsize(tr) > SESSION_MAX_BYTES
    except OSError:
        return False


def build_claude_cmd(t):
    cont = False
    cmd = [CLAUDE, "-p"]
    fresh_from = None
    if t.get("session_id") and session_too_big(t["session_id"]):
        fresh_from, t["session_id"] = t["session_id"], None       # handoff instead of reloading a huge context
    if t.get("resume_session_id") and not t.get("session_id") and session_too_big(t["resume_session_id"]):
        fresh_from, t["resume_session_id"] = t["resume_session_id"], None
    if t.get("session_id"):  # an earlier attempt of this task already has a session: continue it
        cmd += ["--resume", t["session_id"]]
        cont = True
    elif t.get("resume_session_id"):
        cmd += ["--resume", t["resume_session_id"]]
        if t.get("fork_session"):
            cmd += ["--fork-session"]
        else:
            t["session_id"] = t["resume_session_id"]
    else:
        t["session_id"] = str(uuid.uuid4())
        cmd += ["--session-id", t["session_id"]]
    if cont:
        n = notes_for([t["id"], t.get("label")])
        prompt = ("You were stopped (usage limit or error: %s). Continue the task from where you left off; "
                  "re-check live state first, don't redo finished steps.%s"
                  % ((t.get("last_error") or "?")[:200], ("\nYour resume notes:\n" + n) if n else ""))
    else:
        prompt = t["prompt"]
        if t.get("message"):
            prompt += "\n" + t["message"]
    if fresh_from:
        n = notes_for([t["id"], t.get("label")])
        tr = find_transcript(fresh_from) or "?"
        prompt = ("HANDOFF: an earlier session on this task (%s) grew too large to resume cheaply, so this is a fresh "
                  "session. Its transcript: %s (read only the end: `aq transcript %s --last 40`). Re-check live "
                  "state first and don't redo finished steps.%s\n\nThe original task:\n%s"
                  % (fresh_from, tr, tr, ("\nResume notes:\n" + n) if n else "", prompt))
    cmd += ["--output-format", "json", "--append-system-prompt", PREAMBLE.format(id=t["id"])]
    if t.get("permission_mode"):
        cmd += ["--permission-mode", t["permission_mode"]]
    if t.get("model"):
        cmd += ["--model", t["model"]]
    if t.get("effort"):
        cmd += ["--effort", t["effort"]]
    cmd += ["--", prompt.replace("{task}", t["id"])]
    return cmd


def build_dsh_cmd(t, env):
    n = notes_for([t["id"], t.get("label")])
    prompt = DSH_PREAMBLE.format(id=t["id"]) + t["prompt"].replace("{task}", t["id"])
    if n:
        prompt += "\n\nNotes left by earlier runs of this task:\n" + n
    # The bin/dsh launcher's non-TTY path is `exec node_modules/.bin/dsh` (a shebang script behind a symlink). Under
    # launchd, macOS refuses to exec that from ~/Documents (EPERM), while `node lib/bin.js` works. So do what the
    # launcher does, directly: DSH_HOME + DSH_PERMISSION_MODE, then node on the real entry point.
    root = os.path.dirname(os.path.dirname(os.path.realpath(DSH)))
    entry = os.path.join(root, "node_modules", ".bin", "dsh")
    node = shutil.which("node", path=env.get("PATH"))
    if os.path.basename(DSH) == "dsh" and os.path.exists(entry) and node:
        env.setdefault("DSH_HOME", os.path.join(root, "home"))
        env.setdefault("DSH_PERMISSION_MODE", "workspace-write")
        return [node, os.path.realpath(entry), "--profile", "headless", prompt]
    return [DSH, "--profile", "headless", prompt]


def build_codex_cmd(t, last_path):
    """codex exec, non-interactive: workspace-write sandbox with network (ssh to the servers works), never asks for
    approval, cwd = a scratch dir per task, extra writable dirs CODEX_DIRS, events as JSONL on stdout, the final
    message to last_path."""
    n = notes_for([t["id"], t.get("label")])
    prompt = CODEX_PREAMBLE.format(id=t["id"], model=t.get("model") or CODEX_MODEL) + t["prompt"].replace("{task}", t["id"])
    if t.get("message"):
        prompt += "\n" + t["message"]
    if n:
        prompt += "\n\nNotes left by earlier runs of this task:\n" + n
    cwd = os.path.join(CODEX_WORK, t["id"])
    os.makedirs(cwd, exist_ok=True)
    cmd = [CODEX, "exec", "-m", t.get("model") or CODEX_MODEL, "-s", "workspace-write",
           "-c", "sandbox_workspace_write.network_access=true", "-c", 'approval_policy="never"',
           "--skip-git-repo-check", "-C", cwd, "--json", "-o", last_path]
    if t.get("effort"):
        cmd += ["-c", 'model_reasoning_effort="%s"' % t["effort"]]
    for d in CODEX_DIRS:
        if os.path.isdir(d):
            cmd += ["--add-dir", d]
    return cmd + ["--", prompt], cwd


class Runner:
    def __init__(self):
        self.procs = {}  # tid -> (Popen, mode, started, out_path, log_fh)
        self.last_sweep = 0

    def recover(self):
        with qlock():
            for t in all_tasks():
                if t["status"] == "running" and not alive(t.get("pid")):
                    t["status"] = "pending"
                    t["pid"] = None
                    event(t, "runner restarted; was running, back to pending")
                    save(t)
                    rlog("recover %s -> pending" % t["id"])

    def start(self, t, mode):
        log_path = os.path.join(LOGS, t["id"] + ".log")
        out_path = os.path.join(LOGS, "%s.%d.%s.out" % (t["id"], t["attempts"] + t["limit_hits"] + 1, mode))
        env = dict(os.environ, AQ_TASK_ID=t["id"], AQ_HOME=HOME)
        env.setdefault("PATH", "/usr/bin:/bin")
        for extra in (os.path.expanduser("~/.local/bin"), "/opt/homebrew/bin", "/usr/local/bin"):
            if extra not in env["PATH"].split(":"):
                env["PATH"] += ":" + extra
        if mode == "claude":
            cmd = build_claude_cmd(t)
            cwd = t.get("cwd") if os.path.isdir(t.get("cwd") or "") else HOME
            env.pop("CLAUDECODE", None)
            for k in ("CLAUDE_CODE_SESSION_ID", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_MESSAGING_SOCKET",
                      "CLAUDE_CODE_MESSAGING_TOKEN", "CLAUDE_PID", "CLAUDE_CODE_SESSION_ATTENDED"):
                env.pop(k, None)
        elif mode == "codex":
            cmd, cwd = build_codex_cmd(t, out_path[:-4] + ".last")
        else:
            cmd = build_dsh_cmd(t, env)
            cwd = t["cwd"] if t.get("dsh_cwd") and os.path.isdir(t.get("cwd") or "") else os.path.join(WORK, t["id"])
            os.makedirs(cwd, exist_ok=True)
            env["DSH_KEEP_CWD"] = "1"
            env["DSH_NO_LLM_MODE"] = "1"  # never evict AS2 Clash jobs from an unattended run
        lf = open(log_path, "a")
        lf.write("\n===== %s start %s attempt=%d limit_hits=%d cwd=%s\n$ %s\n" % (
            iso(), mode, t["attempts"], t["limit_hits"], cwd,
            " ".join(c if len(c) < 120 else c[:117] + "..." for c in cmd)))
        lf.flush()
        out = open(out_path, "w")
        p = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=out,
                             stderr=(lf if mode in ("claude", "codex") else subprocess.STDOUT), start_new_session=True)
        out.close()
        t["status"] = "running"
        t["pid"] = p.pid
        t["mode"] = mode
        t["started"] = now()
        event(t, "start %s pid=%d" % (mode, p.pid))
        save(t)
        self.procs[t["id"]] = (p, mode, now(), out_path, lf)
        rlog("start %s %s pid=%d" % (t["id"], mode, p.pid))

    def finish(self, tid, rc):
        p, mode, started, out_path, lf = self.procs.pop(tid)
        try:
            with open(out_path, errors="replace") as f:
                out = f.read()
        except OSError:
            out = ""
        lf.write("----- output (%s)\n%s\n===== %s exit rc=%s after %ds\n" % (out_path, out[-20000:], iso(), rc,
                                                                            now() - started))
        lf.close()
        try:
            with open(os.path.join(LOGS, tid + ".log"), errors="replace") as f:
                f.seek(0, 2)
                f.seek(max(0, f.tell() - 30000))
                logtail = f.read()
        except OSError:
            logtail = ""
        with qlock():
            t = load(tid)
            if not t:
                return
            t["pid"] = None
            if t["status"] == "cancelled":
                event(t, "exited rc=%s after cancel" % rc)
                save(t)
                return
            result, is_error, limit, reset = None, rc != 0, False, None
            if mode == "claude":
                j = None
                for line in reversed(out.strip().splitlines()):
                    try:
                        j = json.loads(line)
                        break
                    except ValueError:
                        continue
                if j is None:
                    try:
                        j = json.loads(out)
                    except ValueError:
                        j = None
                if isinstance(j, dict):
                    result = j.get("result")
                    is_error = bool(j.get("is_error")) or rc != 0
                    if j.get("session_id"):
                        t["session_id"] = j["session_id"]
                tl = transcript_limit(find_transcript(t.get("session_id")))
                text = (result or "") + "\n" + out[-4000:] + "\n" + logtail[-4000:]
                if is_error and (tl or LIMIT_RE.search(text)):
                    limit = True
                    reset = (tl[0] if tl else None) or parse_reset(text)
            elif mode == "codex":
                try:
                    with open(out_path[:-4] + ".last", errors="replace") as f:
                        result = f.read().strip()
                except OSError:
                    result = None
                if not result:   # no final message: the last error events of the JSONL stream say why
                    errs = [ln for ln in out.splitlines() if '"error"' in ln or '"turn.failed"' in ln]
                    result = "\n".join(errs[-3:])[-2000:] or out.strip()[-2000:]
                    is_error = True
                if LIMIT_RE.search(result or ""):
                    t["last_error"] = "codex usage limit: " + result[-200:]
            else:
                result = out.strip()[-4000:]
            t["result"] = (result or "")[-8000:] if result else t.get("result")
            if limit:
                until = block_until(reset, "task %s: %s" % (tid, (result or text.strip())[-200:]))
                t["status"] = "pending"
                t["limit_hits"] += 1
                t["last_error"] = "usage limit (reset %s)" % local(until)
                event(t, "usage limit; pending until %s" % iso(until))
                rlog("limit %s; blocked until %s" % (tid, iso(until)))
            elif not is_error:
                if mode == "claude":
                    put_state(blocked_until=0, blocked_why="cleared by success of %s" % tid)
                t["finished"] = now()
                t["ran_on"] = mode
                if t.get("every_s"):
                    t["status"] = "pending"
                    t["not_before"] = now() + t["every_s"]
                    t["attempts"] = 0
                    t["session_id"] = None
                    event(t, "done on %s; recurring, next %s" % (mode, iso(t["not_before"])))
                else:
                    t["status"] = "done"
                    event(t, "done on %s" % mode)
                rlog("done %s on %s" % (tid, mode))
            else:
                t["attempts"] += 1
                t["last_error"] = ("rc=%s %s" % (rc, (result or logtail.strip())[-300:])).strip()
                if t["attempts"] < t["max_attempts"]:
                    t["status"] = "pending"
                    t["not_before"] = now() + 300 * t["attempts"]
                    event(t, "failed rc=%s; retry %d/%d at %s" % (rc, t["attempts"] + 1, t["max_attempts"],
                                                                  iso(t["not_before"])))
                else:
                    t["status"] = "failed"
                    t["finished"] = now()
                    event(t, "failed rc=%s; out of attempts" % rc)
                rlog("error %s rc=%s -> %s" % (tid, rc, t["status"]))
            save(t)

    def superseded(self, t):
        src = t.get("source") or {}
        if t["kind"] not in ("resume-agent", "resume-session") or t.get("session_id") or not src.get("failed_at"):
            return False
        path = src.get("transcript") or (find_agent_transcript(src["agent_id"]) if src.get("agent_id")
                                         else find_transcript(src.get("session_id")))
        return bool(path) and resumed_since(path, src["failed_at"])

    def tick(self):
        for tid, (p, *_rest) in list(self.procs.items()):
            rc = p.poll()
            if rc is not None:
                self.finish(tid, rc)
        for tid, (p, mode, started, _o, _l) in list(self.procs.items()):
            t = load(tid) or {}
            lim = t.get("timeout_s") or {"claude": 10800, "codex": 2700}.get(mode, 1800)
            if t.get("status") == "cancelled" or now() - started > lim:
                with contextlib.suppress(Exception):
                    os.killpg(p.pid, signal.SIGTERM)
                if t.get("status") != "cancelled":
                    rlog("timeout %s after %ds" % (tid, lim))
        if now() - self.last_sweep > SWEEP_EVERY:
            self.last_sweep = now()
            try:
                sweep()
            except Exception as e:  # never let the sweeper kill the runner
                rlog("sweep error: %r" % e)
        blocked, st = is_blocked()
        if st.get("paused"):
            return
        pend = [t for t in all_tasks() if t["status"] == "pending" and t.get("not_before", 0) <= now()
                and t["id"] not in self.procs]
        pend.sort(key=lambda t: (-t.get("priority", 5), t.get("created", 0)))
        for t in pend:
            other = sum(1 for _p, m, *_r in self.procs.values() if m != "claude")
            if len(self.procs) - other >= MAX_PAR and other >= MAX_PAR_OTHER:
                break
            if self.superseded(t):
                with qlock():
                    t = load(t["id"])
                    t["status"] = "done"
                    t["result"] = "superseded: the session/agent was resumed by someone else after the limit"
                    event(t, "superseded")
                    save(t)
                rlog("superseded %s" % t["id"])
                continue
            if t.get("runner") in ("dsh", "codex"):
                mode = t["runner"]
            elif blocked:
                if t.get("fallback") != "dsh":
                    continue
                mode = "dsh"
            else:
                mode = "claude"
            if (mode == "claude" and len(self.procs) - other >= MAX_PAR) or \
                    (mode != "claude" and other >= MAX_PAR_OTHER):
                continue   # this family's slots are full (claude: MAX_PAR; dsh + codex: MAX_PAR_OTHER)
            with qlock():
                t = load(t["id"])
                if t and t["status"] == "pending":
                    self.start(t, mode)
            if mode == "claude":
                break  # one claude start per tick: a fresh limit hit stops the rest without hammering

    def loop(self):
        self.recover()
        rlog("runner up pid=%d max_parallel=%d+%d claude=%s dsh=%s codex=%s" % (os.getpid(), MAX_PAR, MAX_PAR_OTHER,
                                                                                CLAUDE, DSH, CODEX))
        stop = []
        signal.signal(signal.SIGTERM, lambda *a: stop.append(1))
        once = os.environ.get("AQ_ONCE")
        while not stop:
            self.tick()
            if once and not self.procs and not [t for t in all_tasks() if t["status"] == "pending"]:
                break  # test mode: drain everything, including tasks waiting for a limit reset
            time.sleep(min(POLL, 2) if self.procs else POLL)
        rlog("runner down")


# ----------------------------------------------------------------------------------------- hook and sweeper
def own_sessions():
    return {t.get("session_id") for t in all_tasks()} | {t.get("resume_session_id") for t in all_tasks()}


def sweep():
    """Find agents/sessions that died at a usage limit (backup for the hook) and queue their resumption."""
    st = get_state()
    since = st.get("sweep_since")
    if not since:
        put_state(sweep_since=now())  # first run: only deaths from now on
        return
    mine = own_sessions()
    cutoff = max(since, now() - 12 * 3600)
    for path in glob.glob(os.path.join(PROJECTS, "*", "*", "subagents", "agent-*.jsonl")) + \
            glob.glob(os.path.join(PROJECTS, "*", "*", "subagents", "*", "*", "agent-*.jsonl")):
        if os.path.getmtime(path) < cutoff:
            continue
        tl = transcript_limit(path)
        if not tl or tl[1] < since:
            continue
        aid = os.path.basename(path)[6:-6]
        if find_by_source("agent_id", aid):
            continue
        sid = (tail_records(path, 1) or [{}])[-1].get("sessionId")
        if sid in mine:
            continue
        block_until(tl[0], "sweep: agent %s hit the limit" % aid)
        t = enqueue_resume_agent(aid, transcript=path, failed_at=tl[1], owner="sweeper")
        rlog("sweep queued %s for agent %s" % (t["id"], aid))
    for path in glob.glob(os.path.join(PROJECTS, "*", "*.jsonl")):
        if os.path.getmtime(path) < cutoff:
            continue
        sid = os.path.basename(path)[:-6]
        if sid in mine or find_by_source("session_id", sid) and \
                (find_by_source("session_id", sid).get("kind") == "resume-session"):
            continue
        tl = transcript_limit(path)
        if not tl or tl[1] < since:
            continue
        block_until(tl[0], "sweep: session %s hit the limit" % sid)
        t = enqueue_resume_session(sid, failed_at=tl[1], owner="sweeper")
        rlog("sweep queued %s for session %s" % (t["id"], sid))


def cmd_hook(_a):
    """Claude Code StopFailure hook (matcher rate_limit). Reads the hook JSON on stdin. Always exits 0."""
    try:
        raw = sys.stdin.read()
        ensure_dirs()
        with open(HOOKLOG, "a") as f:
            f.write("%s %s\n" % (iso(), raw.strip()[:4000]))
        d = json.loads(raw or "{}")
        err = str(d.get("error") or "")
        text = json.dumps(d.get("error_details") or "") + " " + str(d.get("last_assistant_message") or "")
        if d.get("hook_event_name") not in (None, "StopFailure"):
            return
        if err != "rate_limit" and not LIMIT_RE.search(text):
            return
        sid = d.get("session_id")
        aid = d.get("agent_id")
        tr = find_agent_transcript(aid) if aid else (d.get("transcript_path") or find_transcript(sid))
        tl = transcript_limit(tr) if tr else None
        reset = (tl[0] if tl else None) or parse_reset(text)
        failed_at = tl[1] if tl else now()
        block_until(reset, "hook: %s %s" % (aid or sid, text[-150:]))
        if os.environ.get("AQ_TASK_ID") or sid in own_sessions():
            return  # a queue task: the runner re-queues it itself
        if aid:
            if not find_by_source("agent_id", aid):
                enqueue_resume_agent(aid, transcript=tr, failed_at=failed_at, session_id=sid, cwd=d.get("cwd"),
                                     owner="hook")
        elif not tl:
            # No agent id and the session transcript does not end in a limit error: most likely a background agent
            # of this session. The sweeper finds it by its own transcript.
            time.sleep(2)
            sweep()
        elif sid:
            prev = find_by_source("session_id", sid)
            if not (prev and prev.get("kind") == "resume-session" and prev["status"] in ACTIVE):
                enqueue_resume_session(sid, failed_at=failed_at, cwd=d.get("cwd"), owner="hook")
    except Exception as e:  # a hook must never break the session
        with contextlib.suppress(Exception):
            with open(HOOKLOG, "a") as f:
                f.write("%s hook error %r\n" % (iso(), e))


# -------------------------------------------------------------------------------------------------- notes
def safe(k):
    return re.sub(r"[^A-Za-z0-9._-]", "_", k)[:120]


def cmd_note(a):
    text = " ".join(a.text) if a.text else sys.stdin.read()
    ensure_dirs()
    key = a.key
    with contextlib.suppress(SystemExit):
        if os.path.exists(TASKS):
            t = [x for x in all_tasks() if x["id"] == key or x.get("label") == key]
            if t:
                key = t[-1]["id"]
    hdr = "## %s session=%s cwd=%s%s\n" % (iso(), os.environ.get("CLAUDE_CODE_SESSION_ID", "-"), os.getcwd(),
                                         (" task=" + os.environ["AQ_TASK_ID"]) if os.environ.get("AQ_TASK_ID") else "")
    with open(os.path.join(NOTES, safe(key) + ".md"), "a") as f:
        f.write(hdr + text.strip() + "\n\n")
    print("noted under %s" % key)


def cmd_notes(a):
    files = sorted(glob.glob(os.path.join(NOTES, "*.md")), key=os.path.getmtime)
    if a.key:
        files = [f for f in files if os.path.basename(f)[:-3] in (safe(a.key),)] or \
                [f for f in files if safe(a.key) in os.path.basename(f)]
    if a.recent:
        files = [f for f in files if os.path.getmtime(f) > now() - parse_duration(a.recent)]
    shown = 0
    for f in files:
        body = open(f).read()
        if a.session and a.session not in body and not (a.agent and a.agent in body):
            continue
        print("=== %s (%s)" % (os.path.basename(f)[:-3], local(os.path.getmtime(f))))
        print(body[-a.chars:])
        shown += 1
    if not shown:
        print("(no notes)")


def cmd_transcript(a):
    path = a.path
    if not os.path.exists(path):
        path = find_agent_transcript(a.path) or find_transcript(a.path) or path
    recs = []
    with open(path, errors="replace") as f:
        for line in f:
            with contextlib.suppress(ValueError):
                recs.append(json.loads(line))

    def show(r):
        msg = r.get("message") or {}
        c = msg.get("content")
        role = r.get("type")
        items = [{"type": "text", "text": c}] if isinstance(c, str) else (c or [])
        for x in items:
            if not isinstance(x, dict):
                continue
            k = x.get("type")
            if k == "text" and x.get("text", "").strip():
                print("[%s] %s" % (role, x["text"].strip()[:a.width]))
            elif k == "tool_use":
                print("[tool %s] %s" % (x.get("name"), json.dumps(x.get("input"))[:a.width]))
            elif k == "tool_result":
                cc = x.get("content")
                if isinstance(cc, list):
                    cc = " ".join(y.get("text", "") for y in cc if isinstance(y, dict))
                print("[result] %s" % str(cc).strip()[:a.width // 2])
    if a.first:
        for r in recs[:a.first]:
            show(r)
        print("...")
    for r in recs[-a.last:]:
        show(r)


