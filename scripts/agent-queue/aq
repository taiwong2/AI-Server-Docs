def enqueue_resume_agent(agent_id, message="", priority=6, transcript=None, failed_at=None, session_id=None,
                         cwd=None, owner=None, label=None):
    tr = transcript or find_agent_transcript(agent_id)
    if tr:
        recs = tail_records(tr, 1)
        if recs:
            session_id = session_id or recs[-1].get("sessionId")
            cwd = cwd or recs[-1].get("cwd")
    prompt = RESUME_AGENT.format(agent_id=agent_id, session_id=session_id or "?", cwd=cwd or "?",
                                 failed=iso(failed_at) if failed_at else "?", transcript=tr or "(not found)",
                                 message=("Message for the resumed agent: " + message) if message else "")
    return make_task(prompt, kind="resume-agent", priority=priority, cwd=cwd or os.getcwd(), owner=owner,
                     label=label or ("resume-" + agent_id[:10]),
                     source={"agent_id": agent_id, "session_id": session_id, "transcript": tr,
                             "failed_at": failed_at})


def enqueue_resume_session(session_id, message="", priority=4, failed_at=None, cwd=None, owner=None, fork=True):
    tr = find_transcript(session_id)
    if tr and not cwd:
        recs = tail_records(tr, 1)
        cwd = recs[-1].get("cwd") if recs else None
    prompt = RESUME_SESSION.format(failed=iso(failed_at) if failed_at else "?", message=message)
    return make_task(prompt, kind="resume-session", priority=priority, cwd=cwd or os.getcwd(), owner=owner,
                     resume_session_id=session_id, fork_session=fork, label="resume-session-" + session_id[:8],
                     source={"session_id": session_id, "transcript": tr, "failed_at": failed_at})


