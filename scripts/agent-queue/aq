def cmd_add(a):
    prompt = " ".join(a.prompt) if a.prompt else ""
    if a.file:
        prompt = open(a.file).read() if a.file != "-" else sys.stdin.read()
    kw = dict(label=a.label, priority=a.priority, owner=a.owner, fallback=a.fallback, runner=a.runner,
              permission_mode=a.permission_mode, model=a.model, effort=a.effort, max_attempts=a.max_attempts,
              cwd=os.path.abspath(a.cwd) if a.cwd else None, dsh_cwd=bool(a.cwd) or None,
              timeout_s=parse_duration(a.timeout) if a.timeout else None,
              not_before=parse_when(a.at) if a.at else None,
              every_s=parse_duration(a.every) if a.every else None)
    if a.resume_agent:
        t = enqueue_resume_agent(a.resume_agent, message=prompt, priority=a.priority or 6, owner=a.owner,
                                 label=a.label, cwd=os.path.abspath(a.cwd) if a.cwd else None)
        with qlock():
            t = load(t["id"])
            t.update({k: v for k, v in kw.items() if v is not None and k not in ("cwd", "label", "priority")})
            save(t)
    elif a.resume:
        if not prompt:
            sys.exit("aq: --resume needs a message")
        t = make_task(prompt, kind="resume-session", resume_session_id=a.resume, fork_session=a.fork, **kw)
    else:
        if not prompt:
            sys.exit("aq: empty prompt")
        t = make_task(prompt, **kw)
    print(t["id"])


def fmt_row(t):
    st = t["status"]
    if st == "pending" and t.get("not_before", 0) > now():
        st = "wait " + local(t["not_before"])
    flag = t.get("runner") if t.get("runner") in ("dsh", "codex") else ("fb:dsh" if t.get("fallback") == "dsh" else "")
    title = t.get("label") or t["prompt"].strip().splitlines()[0]
    return "%-25s %-15s p%-2s %-6s %-2s %-2s %-11s %s" % (t["id"], st, t.get("priority"), flag, t["attempts"],
                                                         t["limit_hits"], local(t["created"]), title[:60])


def cmd_list(a):
    blocked, s = is_blocked()
    rpid = runner_pid()
    print("runner: %s   claude: %s%s" % (("up pid %d" % rpid) if rpid else "DOWN",
                                         ("BLOCKED until %s (%s)" % (local(s["blocked_until"]),
                                                                     s.get("blocked_why", "")[:80]))
                                         if blocked else "available", "   PAUSED" if s.get("paused") else ""))
    print("%-25s %-15s %-3s %-6s %-2s %-2s %-11s %s" % ("id", "status", "pri", "mode", "at", "lh", "created",
