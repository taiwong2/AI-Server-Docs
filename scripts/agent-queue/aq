MAX_PAR = int(os.environ.get("AQ_MAX_PARALLEL", "2"))
POLL = float(os.environ.get("AQ_POLL", "20"))
SWEEP_EVERY = float(os.environ.get("AQ_SWEEP_EVERY", "300"))
DEFAULT_TZ = os.environ.get("AQ_TZ", "America/Chicago")
LIMIT_FALLBACK_WAIT = int(os.environ.get("AQ_LIMIT_FALLBACK_WAIT", "1800"))  # reset time unparseable
