def tw_log(msg):
    ensure_dirs()
    with open(TW_LOG, "a") as f:
        f.write("%s %s\n" % (iso(), msg))
    print(msg)


def tw_fetch():
    """-> (incidents view, error). Prefers `train_guard.py incidents --json`; falls back to the raw state file
    (a deploy copy without that command) and derives ids / kinds here."""
    cmd = ["ssh", "-o", "ConnectTimeout=20", "-o", "BatchMode=yes", TW_HOST,
           "python3 %s incidents --json 2>/dev/null || cat ~/clash-jobs/state/train_guard.json" % TW_GUARD]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=90)
    except (subprocess.TimeoutExpired, OSError) as e:
        return None, repr(e)
    if r.returncode != 0:
        return None, "ssh rc=%d %s" % (r.returncode, (r.stderr or r.stdout).strip()[-200:])
    try:
        return tw_view(json.loads(r.stdout)), None
    except ValueError as e:
        return None, "bad json: %r" % e


def tw_kind(key, status):
    s = (status or "").lower()
    if key.startswith("data:"):
        return "data-missing"
    if key == "main":
        return "main-down"
    if key.startswith("ab:"):
        return "ab-stuck"
    if key.startswith("gpu") or key == "igpu":
        if "unreachable" in s or "not reported" in s:
            return "gpu-unreachable"
        return "backlog-dry" if "backlog dry" in s else "gpu-idle"
    return "other"


def tw_view(d, t=None):
    """Normalise either format to {age_s, llm_on, main, incidents: [{id, key, kind, age_s, needs_human, paused, ...}]}."""
    t = t or now()
    if "age_s" in d and isinstance(d.get("incidents"), list) and all("kind" in i for i in d["incidents"]):
        d["age_s"] = t - (d.get("generated_at") or 0)
        for i in d["incidents"]:
            i["age_s"] = t - i["opened_at"]
        d["reservations"] = [r for r in d.get("reservations") or [] if float(r.get("until") or 0) > t]
        return d
    pauses = {k: p for k, p in (d.get("pauses") or {}).items() if p.get("until", 0) > t}
    inc = []
    for i in d.get("incidents") or []:
        if i.get("closed_at"):
            continue
        i = dict(i)
        keys = ("main", "main-learner", "main-cap") if i["key"] == "main" else (i["key"],)
        i.setdefault("id", "%s@%d" % (i["key"], int(i["opened_at"])))
        i["kind"] = i.get("kind") or tw_kind(i["key"], i.get("status"))
        i["needs_human"] = "needs a human" in (i.get("status") or "")
        i["paused"] = any(k in pauses for k in keys)
        i["age_s"] = t - i["opened_at"]
        i.setdefault("actions", [])
        inc.append(i)
    return {"generated_at": d.get("generated_at"), "age_s": t - (d.get("generated_at") or 0), "mode": d.get("mode"),
            "llm_on": d.get("llm_on"), "main": (d.get("main") or {}).get("id") if isinstance(d.get("main"), dict)
            else d.get("main"), "incidents": inc, "pauses": pauses,
            "reservations": [r for r in d.get("reservations") or [] if float(r.get("until") or 0) > t],
            "current_md": d.get("current_md")}


def tw_due(v, t=None, stale_streak=None):
    """The deterministic rule: -> [(incident, reason)] that warrant a fixer now (before dedupe / cooldown)."""
    t = t or now()
    due = []
    if v["age_s"] > TW_STALE_MIN * 60 and v.get("generated_at"):
        if (stale_streak if stale_streak is not None else TW_STALE_PASSES) < TW_STALE_PASSES:
            return due   # stale, but maybe AS2 only just woke up: wait for more passes
        due.append(({"id": "guard-stale@%d" % int(v["generated_at"]), "key": "guard", "kind": "guard-stale",
                     "what": "train guard", "status": "state %.0f min old" % (v["age_s"] / 60), "age_s": v["age_s"],
                     "needs_human": False, "paused": False, "actions": []}, "guard state stale"))
        return due   # its incidents are stale too
    reserved = {r.get("resource"): r for r in v.get("reservations") or []}
    for i in v["incidents"]:
        if i.get("paused"):
            continue    # an agent paused that key for manual ops: hands off
        if i.get("reserved") or (i["kind"] in ("gpu-idle", "backlog-dry") and i["key"] in reserved):
            continue    # CURRENT reserves that GPU for another generation: idle by plan, never a fixer
        thr = TW_CFG.get(i["kind"], None)
        if i.get("needs_human"):
            due.append((i, "guard gave up (needs a human)"))
        elif thr is not None and i["age_s"] >= thr * 60:
            due.append((i, "open %.0f min >= %s min" % (i["age_s"] / 60, thr)))
    return due


def tw_prompt(v, due):
    lines, tried, kinds = [], [], []
    for i, why in due:
        lines.append("- %s  kind=%s  %s  open %.0f min%s: %s  [trigger: %s]" % (
            i["id"], i["kind"], i.get("what") or i["key"], i["age_s"] / 60,
            "  NEEDS A HUMAN" if i.get("needs_human") else "", i.get("status"), why))
        for a in i.get("actions") or []:
            tried.append("- %s %s: %s" % (iso(a[0]), a[1], a[2]))
        if i["kind"] not in kinds:
            kinds.append(i["kind"])
    pb = []
    for k in kinds:
        names = ", ".join(i.get("what") or i["key"] for i, _ in due if i["kind"] == k)
        pb.append("[%s] " % k + TW_PLAYBOOK.get(k, TW_PLAYBOOK["other"]).format(
            main=v.get("main") or "gen3", name=names, age="%.0f min" % (v["age_s"] / 60)))
    return TW_PROMPT.format(when=iso(), n=len(due), lines="\n".join(lines), guard=TW_GUARD, timeout=TW_TIMEOUT,
                            tried="\n".join(tried[-12:]) or "- (none recorded)", playbook="\n\n".join(pb),
                            current=(v.get("current_md") or "").strip() or TW_NO_CURRENT)


TW_NO_CURRENT = ("(CURRENT.md could not be read with the incidents. Read it yourself FIRST: ssh ai-server-2 "
                 "'python3 ~/ClashEngineering/ops/strixhalo/current.py show'. If that fails too, do not act on any "
                 "idle GPU: note it and stop.)")


def tw_current(timeout=60):
