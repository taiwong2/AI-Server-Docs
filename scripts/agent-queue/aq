def new_id():
    return dt.datetime.now().strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:4]


def make_task(prompt, **kw):
    t = {
        "id": new_id(), "label": None, "prompt": prompt, "cwd": os.getcwd(), "priority": 5, "created": now(),
        "owner": os.environ.get("AQ_OWNER") or ("claude:" + os.environ["CLAUDE_CODE_SESSION_ID"]
                                               if os.environ.get("CLAUDE_CODE_SESSION_ID") else "user"),
        "status": "pending", "attempts": 0, "max_attempts": 3, "limit_hits": 0, "last_error": None,
        "runner": "claude", "fallback": "none", "resume_session_id": None, "fork_session": False,
        "session_id": None, "permission_mode": None, "model": None, "effort": None, "timeout_s": None,
        "not_before": 0, "every_s": None, "kind": "task", "source": None, "pid": None, "dsh_cwd": False,
    }
    t.update({k: v for k, v in kw.items() if v is not None})
    event(t, "created by %s" % t["owner"])
    with qlock():
        save(t)
    return t


def find_by_source(key, value):
