# ----------------------------------------------------------------------------------------------------------- utils
def now():
    return time.time()


def iso(t=None):
    if t is None:
        t = now()
    return dt.datetime.fromtimestamp(t, dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def local(t):
    if not t:
        return "-"
    return dt.datetime.fromtimestamp(t).strftime("%m-%d %H:%M")


def ensure_dirs():
    for d in (HOME, TASKS, LOGS, NOTES, WORK):
        os.makedirs(d, exist_ok=True)


_LOCK_DEPTH = [0]


@contextlib.contextmanager
def qlock():
    """Queue-wide lock (flock), reentrant within this process."""
    if _LOCK_DEPTH[0]:
        _LOCK_DEPTH[0] += 1
        try:
            yield
        finally:
            _LOCK_DEPTH[0] -= 1
        return
    ensure_dirs()
    with open(LOCK, "a") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        _LOCK_DEPTH[0] = 1
        try:
            yield
        finally:
            _LOCK_DEPTH[0] = 0
            fcntl.flock(f, fcntl.LOCK_UN)


def write_json(path, obj):
    tmp = "%s.tmp%d" % (path, os.getpid())
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1, sort_keys=True)
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def tpath(tid):
    return os.path.join(TASKS, tid + ".json")


def load(tid):
    return read_json(tpath(tid))


def save(t):
    t["updated"] = now()
    write_json(tpath(t["id"]), t)


def all_tasks():
    out = []
    for p in glob.glob(os.path.join(TASKS, "*.json")):
        t = read_json(p)
        if t:
            out.append(t)
    out.sort(key=lambda t: t.get("created", 0))
    return out


def resolve(ref):
    ts = all_tasks()
    exact = [t for t in ts if t["id"] == ref]
    if exact:
        return exact[0]
    m = [t for t in ts if t["id"].startswith(ref) or t["id"].endswith(ref)]
    if not m:
        m = [t for t in ts if t.get("label") == ref]
        m = m[-1:]  # newest with that label
    if len(m) != 1:
        sys.exit("aq: %s task matches %r" % ("no" if not m else "more than one", ref))
    return m[0]


def event(t, msg):
    t.setdefault("history", []).append([iso(), msg])
    t["history"] = t["history"][-50:]


def rlog(msg):
    ensure_dirs()
    line = "%s %s" % (iso(), msg)
    with open(RUNLOG, "a") as f:
        f.write(line + "\n")
    if os.environ.get("AQ_VERBOSE"):
        print(line, flush=True)


def get_state():
    return read_json(STATE, {}) or {}


def put_state(**kw):
    with qlock():
        s = get_state()
        s.update(kw)
        write_json(STATE, s)
        return s


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def parse_duration(s):
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([smhd]?)\s*", s or "")
    if not m:
        raise SystemExit("aq: bad duration %r (use 90s, 30m, 2h, 1d)" % s)
    return float(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def parse_when(s):
    """'+30m', '21:20' (local, next occurrence), or an ISO timestamp."""
    if s.startswith("+"):
        return now() + parse_duration(s[1:])
    m = re.fullmatch(r"(\d{1,2}):(\d{2})", s)
    if m:
        d = dt.datetime.now().replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        if d.timestamp() <= now():
            d += dt.timedelta(days=1)
        return d.timestamp()
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


# -------------------------------------------------------------------------------------------- limit detection
LIMIT_RE = re.compile(r"(hit your [\w\s-]*limit|usage limit|session limit|weekly limit|rate[_ ]limit|"
                      r"\b429\b|limit reached|out of extra usage)", re.I)
RESET_RE = re.compile(
    r"resets\s+(?:at\s+)?(?:(?P<mon>[A-Z][a-z]{2,8})\s+(?P<day>\d{1,2}),?\s+(?:at\s+)?)?"
    r"(?P<h>\d{1,2})(?::(?P<m>\d{2}))?\s*(?P<ap>[ap]\.?m\.?)\s*(?:\((?P<tz>[^)]+)\))?", re.I)


def parse_reset(text, ref=None):
    """'... resets 9:20pm (America/Chicago)' -> epoch of the next such time (or None)."""
    m = RESET_RE.search(text or "")
    if not m:
        return None
    ref = ref or now()
    tzname = m.group("tz") or DEFAULT_TZ
    try:
        tz = ZoneInfo(tzname) if ZoneInfo else None
    except Exception:
        tz = ZoneInfo(DEFAULT_TZ) if ZoneInfo else None
    h = int(m.group("h")) % 12 + (12 if m.group("ap").lower().startswith("p") else 0)
    mi = int(m.group("m") or 0)
    base = dt.datetime.fromtimestamp(ref, tz)
    if m.group("mon"):
        try:
            month = dt.datetime.strptime(m.group("mon")[:3].title(), "%b").month
        except ValueError:
            month = base.month
        cand = base.replace(month=month, day=int(m.group("day")), hour=h, minute=mi, second=0, microsecond=0)
        if cand.timestamp() < ref - 86400:
            cand = cand.replace(year=cand.year + 1)
    else:
        cand = base.replace(hour=h, minute=mi, second=0, microsecond=0)
        if cand.timestamp() <= ref - 120:
            cand += dt.timedelta(days=1)
    return cand.timestamp()


def find_transcript(session_id):
    if not session_id:
        return None
    m = glob.glob(os.path.join(PROJECTS, "*", session_id + ".jsonl"))
    return m[0] if m else None


def find_agent_transcript(agent_id):
    m = glob.glob(os.path.join(PROJECTS, "*", "*", "subagents", "agent-%s.jsonl" % agent_id))
    m += glob.glob(os.path.join(PROJECTS, "*", "*", "subagents", "*", "*", "agent-%s.jsonl" % agent_id))
    return max(m, key=os.path.getmtime) if m else None


def tail_records(path, n=1, maxbytes=400000):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - maxbytes))
            data = f.read().decode("utf8", "replace")
    except OSError:
        return []
    out = []
    for line in data.splitlines()[-n * 4:]:
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out[-n:]


def record_text(rec):
    msg = rec.get("message") or {}
    c = msg.get("content")
    if isinstance(c, str):
        return c
    if isinstance(c, list):
        return " ".join(x.get("text", "") for x in c if isinstance(x, dict))
    return ""


def transcript_limit(path):
    """If the transcript ends with a usage-limit error: (reset_epoch_or_None, failed_at_epoch, text)."""
    recs = tail_records(path, 1) if path else []
    if not recs:
        return None
    r = recs[-1]
    if r.get("error") != "rate_limit" and r.get("apiErrorStatus") != 429:
        return None
    reset = (r.get("quotaLimits") or {}).get("resetsAt")
    txt = record_text(r)
    failed = r.get("timestamp")
    failed_at = dt.datetime.fromisoformat(failed.replace("Z", "+00:00")).timestamp() if failed else now()
    return (float(reset) if reset else parse_reset(txt, failed_at), failed_at, txt)


def resumed_since(path, since):
    """True if the model produced a normal (non-error) assistant turn in this transcript after `since`."""
    for r in tail_records(path, 400):
        ts = r.get("timestamp")
        if not ts or r.get("type") != "assistant" or r.get("isApiErrorMessage"):
            continue
        if dt.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp() > since + 5:
            return True
    return False


def block_until(reset, why):
    until = (reset or (now() + LIMIT_FALLBACK_WAIT)) + RESET_SLACK
    with qlock():
        s = get_state()
        if until > s.get("blocked_until", 0):
            s["blocked_until"] = until
            s["blocked_why"] = why[:300]
            s["blocked_set"] = now()
            write_json(STATE, s)
    return until


def is_blocked():
    s = get_state()
    return s.get("blocked_until", 0) > now(), s


