def cmd_cancel(a):
    with qlock():
        t = resolve(a.id)
        t["status"] = "cancelled"
        event(t, "cancelled")
        save(t)
    if alive(t.get("pid")):
        with contextlib.suppress(Exception):
            os.killpg(t["pid"], signal.SIGTERM)
    print("cancelled", t["id"])


def cmd_retry(a):
    with qlock():
        t = resolve(a.id)
        t["status"] = "pending"
        t["not_before"] = 0
        t["attempts"] = 0
        if a.fresh:
            t["session_id"] = None
        if a.message:
            t["message"] = " ".join(a.message)
        event(t, "retry requested")
        save(t)
    print("pending", t["id"])


def cmd_log(a):
    t = resolve(a.id)
    p = os.path.join(LOGS, t["id"] + ".log")
    if a.follow:
        os.execvp("tail", ["tail", "-n", "80", "-f", p])
    with open(p, errors="replace") as f:
        data = f.read()
    print(data[-a.chars:])


def runner_pid():
    try:
        with open(RUNLOCK) as f:
            pid = int(f.read().strip() or 0)
        return pid if alive(pid) else 0
    except (OSError, ValueError):
        return 0


def cmd_run(_a):
    ensure_dirs()
    fh = open(RUNLOCK, "a+")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("aq: a runner is already running (pid %s)" % runner_pid())
    fh.seek(0)
    fh.truncate()
    fh.write(str(os.getpid()))
    fh.flush()
    Runner().loop()


def cmd_status(a):
    blocked, s = is_blocked()
    print(json.dumps(dict(s, runner_pid=runner_pid(), blocked=blocked,
                          blocked_until_local=local(s.get("blocked_until"))), indent=1))


def cmd_block(a):
    until = parse_when(a.until)
    put_state(blocked_until=until, blocked_why="manual: " + (a.why or ""), blocked_set=now())
    print("claude blocked until", local(until))


def cmd_unblock(_a):
    put_state(blocked_until=0, blocked_why="manual unblock")
    print("unblocked")


def cmd_pause(a):
    put_state(paused=not a.off)
    print("paused" if not a.off else "resumed")


def cmd_gc(a):
    n = 0
    for t in all_tasks():
        if t["status"] in ("done", "cancelled", "failed") and now() - t.get("updated", 0) > parse_duration(a.older):
            os.replace(tpath(t["id"]), tpath(t["id"]) + ".old")
            n += 1
    print("archived", n)


def main():
    ap = argparse.ArgumentParser(prog="aq", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("add", help="queue a task (or a resume)")
    p.add_argument("prompt", nargs="*")
    p.add_argument("-f", "--file", help="read the prompt from a file ('-' = stdin)")
    p.add_argument("--cwd")
    p.add_argument("--label")
    p.add_argument("-p", "--priority", type=int, help="higher runs first (default 5)")
    p.add_argument("--owner")
    p.add_argument("--fallback", choices=["none", "dsh"], help="dsh: run on dsh while Claude is limited")
    p.add_argument("--runner", choices=["claude", "dsh", "codex"],
                   help="dsh: always run on dsh; codex: always run on `codex exec` (model AQ_CODEX_MODEL, gpt-5.6-luna)")
    p.add_argument("--resume", metavar="SESSION_ID", help="continue this Claude session with the prompt")
    p.add_argument("--fork", action="store_true", help="with --resume: fork instead of appending to the session")
    p.add_argument("--resume-agent", metavar="AGENT_ID", help="continue a dead background agent; prompt = message")
    p.add_argument("--permission-mode")
    p.add_argument("--model")
    p.add_argument("--effort")
    p.add_argument("--timeout", help="kill after (default 3h claude, 45m codex, 30m dsh)")
    p.add_argument("--at", help="not before: +30m, 21:20, or ISO time")
    p.add_argument("--every", help="recurring: run again this long after each success")
    p.add_argument("--max-attempts", type=int)
    p.set_defaults(fn=cmd_add)
    p = sp.add_parser("list", help="list tasks")
    p.add_argument("-a", "--all", action="store_true")
    p.set_defaults(fn=cmd_list)
    for name, fn in (("show", cmd_show), ("cancel", cmd_cancel)):
        p = sp.add_parser(name)
        p.add_argument("id")
        if name == "show":
            p.add_argument("--json", action="store_true")
        p.set_defaults(fn=fn)
    p = sp.add_parser("retry", help="back to pending (keeps its session unless --fresh)")
    p.add_argument("id")
    p.add_argument("message", nargs="*")
    p.add_argument("--fresh", action="store_true")
    p.set_defaults(fn=cmd_retry)
    p = sp.add_parser("log")
    p.add_argument("id")
    p.add_argument("-f", "--follow", action="store_true")
    p.add_argument("--chars", type=int, default=12000)
    p.set_defaults(fn=cmd_log)
    p = sp.add_parser("note", help="record resume state: aq note <task|label> \"state / next steps\"")
    p.add_argument("key")
    p.add_argument("text", nargs="*")
    p.set_defaults(fn=cmd_note)
    p = sp.add_parser("notes")
    p.add_argument("key", nargs="?")
    p.add_argument("--session")
    p.add_argument("--agent")
    p.add_argument("--recent", help="only notes touched within, e.g. 12h")
    p.add_argument("--chars", type=int, default=4000)
    p.set_defaults(fn=cmd_notes)
    p = sp.add_parser("transcript", help="compact view of a Claude transcript (path, agent id or session id)")
    p.add_argument("path")
    p.add_argument("--last", type=int, default=40)
    p.add_argument("--first", type=int, default=0)
    p.add_argument("--width", type=int, default=600)
    p.set_defaults(fn=cmd_transcript)
    sp.add_parser("run", help="the runner loop (LaunchAgent)").set_defaults(fn=cmd_run)
    sp.add_parser("status").set_defaults(fn=cmd_status)
    sp.add_parser("hook", help="StopFailure hook entry (stdin JSON)").set_defaults(fn=cmd_hook)
    sp.add_parser("sweep", help="queue resumes for agents that died at a limit").set_defaults(fn=lambda a: sweep())
    p = sp.add_parser("block", help="treat Claude as limited until a time")
    p.add_argument("until")
    p.add_argument("--why")
    p.set_defaults(fn=cmd_block)
    sp.add_parser("unblock").set_defaults(fn=cmd_unblock)
    p = sp.add_parser("pause", help="stop starting tasks (--off to resume)")
    p.add_argument("--off", action="store_true")
    p.set_defaults(fn=cmd_pause)
    p = sp.add_parser("trainwatch", help="one pass: AS2 train guard incidents -> a Codex fixer task when due")
    p.add_argument("--dry-run", action="store_true", help="print the task it would queue, queue nothing")
    p.add_argument("--state-file", help="read this guard state / incidents JSON instead of ssh (tests)")
    p.add_argument("--effort", help="codex reasoning effort for the fixer (default: config)")
    p.add_argument("-v", "--verbose", action="store_true")
    p.set_defaults(fn=cmd_trainwatch)
    p = sp.add_parser("gc", help="archive finished tasks")
    p.add_argument("--older", default="7d")
    p.set_defaults(fn=cmd_gc)
    a = ap.parse_args()
    ensure_dirs()
    a.fn(a)


