<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.taiwong.trainwatch</string>
  <!-- aq trainwatch every 3 min: one ssh read of the AI Server 2 train guard's incidents; when training stays down
       past a threshold it queues ONE Codex (gpt-5.6-luna) fixer task in aq (deduped per incident, 60-min cooldown,
       6/day). Light: one ssh + a few ms of Python. Off: touch ~/.claude/agent-queue/trainwatch.disabled -->
  <key>ProgramArguments</key>
  <!-- /bin/bash stays the parent (no exec): a launchd job whose program is python3 cannot read ~/Documents (TCC). -->
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>/usr/bin/python3 /Users/taiwong/.claude/agent-queue/bin/aq trainwatch; exit 0</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/taiwong/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/taiwong</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>180</integer>
  <!-- Standard, not Background: as a Background job one pass took 1-2 min (python startup and ssh throttled). -->
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>/Users/taiwong/.claude/agent-queue/trainwatch.launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/taiwong/.claude/agent-queue/trainwatch.launchd.log</string>
</dict>
</plist>
