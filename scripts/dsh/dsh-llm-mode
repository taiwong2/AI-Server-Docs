#!/usr/bin/env bash
# dsh-llm-mode: the client side of AI Server 2's LLM mode (ClashEngineering ops/strixhalo/llmmode.py), used by `dsh`.
#
#   dsh-llm-mode on       wake AI Server 2 if asleep, `llm-mode on` there (moves its Clash jobs off, loads Flash-Next),
#                         wait until the model answers; prints one status line (progress lines dimmed)
#   dsh-llm-mode touch    "a dsh session is alive": resets the 30 min idle unload timer on the box
#   dsh-llm-mode status   llm-mode status on the box
#   dsh-llm-mode off      unload now and give the box back to the Clash jobs
# Env: AIS2_HOST (ssh alias, default ai-server-2), WAKE_AIS2 (wake helper; default wake-ai-server-2 next to this or on
# PATH). Works on macOS and Linux (bash + ssh). Never prints the API key; the model is reached through dsh-mac-proxy.
set -uo pipefail
HOST=${AIS2_HOST:-ai-server-2}
SSH=(ssh -n -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=10 -o ServerAliveCountMax=2 "$HOST")
READY_S=${DSH_READY_S:-180}                          # longest wait for the model before dsh starts anyway
# run "$@" for at most $1 s (macOS has no timeout(1)); its stdout passes through
bounded() { local t=$1; shift; "$@" & local p=$!; ( sleep "$t"; kill "$p" 2>/dev/null ) & local w=$!
  wait "$p"; local rc=$?; kill "$w" 2>/dev/null; wait "$w" 2>/dev/null; return $rc; }
jget() { sed -n "s/.*\"$1\": \"\{0,1\}\([^\",}]*\).*/\1/p" | head -1; }
MODE_F=$HOME/.config/ai-server-2/llm-mode.json      # read by dsh-mac-proxy: fresh = route flash-next only to AS2
mark() { mkdir -p "$(dirname "$MODE_F")"; printf '{"ts": %s000}\n' "$(date +%s)" > "$MODE_F"; }
dim() { if [ -t 2 ]; then printf '\033[2m%s\033[0m\n' "$*" >&2; else printf '%s\n' "$*" >&2; fi; }

wake() {
  bounded 20 "${SSH[@]}" true 2>/dev/null && return 0
  local w=${WAKE_AIS2:-}
  [ -z "$w" ] && for c in "$(dirname "$0")/wake-ai-server-2" "$HOME/.local/bin/wake-ai-server-2" "$(command -v wake-ai-server-2 2>/dev/null)"; do
    [ -n "$c" ] && [ -x "$c" ] && { w=$c; break; }; done
  dim "dsh: AI Server 2 is asleep, waking it (can take a few minutes)"
  if [ -n "$w" ]; then AIS2_WAIT_S=${AIS2_WAIT_S:-1500} "$w" -q; else
    for _ in $(seq 1 150); do bounded 20 "${SSH[@]}" true 2>/dev/null && return 0; sleep 10; done; return 1; fi
}

case "${1:-status}" in
  on)
    t0=$(date +%s)
    wake || { rm -f "$MODE_F"; echo "dsh: AI Server 2 unreachable; the session's requests fail with 503 until it answers (AI Server 1 serves no LLM since 2026-10-12)" >&2; exit 1; }
    st=$(bounded 25 "${SSH[@]}" llm-mode status --json 2>/dev/null | tr -d '\n')
    if [ "$(printf '%s' "$st" | jget model)" = up ] && [ "$(printf '%s' "$st" | jget on)" = true ]; then
      bounded 20 "${SSH[@]}" llm-mode touch >/dev/null 2>&1; mark
      echo "dsh: Flash-Next on AI Server 2 (LLM mode on since $(printf '%s' "$st" | jget since))" >&2; exit 0
    fi
    dim "dsh: LLM mode on AI Server 2: moving its Clash jobs off and loading Flash-Next (waiting up to $READY_S s)"
    bounded 30 "${SSH[@]}" llm-mode on --detach >/dev/null 2>&1 || dim "  (could not start llm-mode on; still polling)"
    while :; do
      sleep 10
      el=$(( $(date +%s) - t0 ))
      st=$(bounded 20 "${SSH[@]}" llm-mode status --json 2>/dev/null | tr -d '\n')
      if [ "$(printf '%s' "$st" | jget model)" = up ] && [ "$(printf '%s' "$st" | jget on)" = true ]; then
        mark; echo "dsh: Flash-Next on AI Server 2 ready (${el} s)" >&2; exit 0; fi
      if [ -n "$st" ]; then dim "  ${el}s: model $(printf '%s' "$st" | jget model), MemAvailable $(printf '%s' "$st" | jget mem_available_gb) GB; $(printf '%s' "$st" | jget last_log | cut -c1-90)"
      else dim "  ${el}s: no answer from AI Server 2 (retrying)"; fi
      if [ "$el" -ge "$READY_S" ]; then
        rm -f "$MODE_F"
        echo "dsh: Flash-Next on AI Server 2 not ready after ${el} s; starting dsh anyway; requests wait for AI Server 2 (the proxy waits up to 3 min, then 503). AI Server 1 serves no LLM. Details: ssh $HOST llm-mode status" >&2
        exit 1
      fi
    done ;;
  touch) bounded 25 "${SSH[@]}" llm-mode touch >/dev/null 2>&1 && mark ;;
  status) bounded 30 "${SSH[@]}" llm-mode status ;;
  off) rm -f "$MODE_F"; bounded 60 "${SSH[@]}" llm-mode off ;;
  *) echo "usage: dsh-llm-mode on|touch|status|off" >&2; exit 2 ;;
esac
