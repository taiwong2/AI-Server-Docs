# sshd for Antoine's environment. Key-only, his user only.
# Forwarding is allowed since 2026-09-29: forwarded connections leave from sshd
# inside the distro, so pp-boot.sh's OUTPUT rules still apply to them.
Port 2222
AllowUsers antoine
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowTcpForwarding yes
AllowStreamLocalForwarding no
GatewayPorts no
PermitTunnel no
X11Forwarding no
AuthorizedKeysFile .ssh/authorized_keys
Subsystem sftp /usr/lib/openssh/sftp-server
